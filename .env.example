# Copy this file to .env and fill in your provider's settings. Restart the server after editing.
# DeepSeek official OpenAI-compatible endpoint.
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
LLM_API_KEY=

# json_object: broad compatibility; json_schema: strict structured output if supported.
# none: prompt-only JSON for providers that don't support response_format.
LLM_RESPONSE_FORMAT=json_object
LLM_TIMEOUT_MS=30000
LLM_MAX_TOKENS=2048
# DeepSeek: disable thinking for lower-latency character interaction.
LLM_THINKING=disabled
# Optional: max_tokens or max_completion_tokens. Normally detected from the base URL.
# LLM_TOKEN_PARAMETER=max_tokens
